                        {
                          "id": "45b56cb3-2007-477c-9a38-5c5fa32a5396",
                          "name": "Success",
                          "originalRequest": {
                            "method": "POST",
                            "header": [
                              {
                                "key": "Accept",
                                "value": "application/json"
                              },
                              {
                                "description": "Added as a part of security scheme: oauth2",
                                "key": "Authorization",
                                "value": "<token>"
                              }
                            ],
                            "url": {
                              "raw": "{{baseUrl}}/v2/book/:book_uuid/business?name=<string>&website=<string>",
