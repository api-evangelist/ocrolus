        {
          "id": "b799feaa-f581-4cae-a3ce-131547b1efb1",
          "name": "Get webhook configuration",
          "request": {
            "name": "Get webhook configuration",
            "description": {
              "content": "Retrieve your most recent webhook configuration.\n\n---\n\nReturns the same object as that of the most recent [webhook registration](ref:configure-webhook).\n\nYou can find a list of supported account-level event types and their sample notifications in the [Account-level webhook guide](doc:account-level-webhook#available-events).\n\n> 🚧 We have a better version!\n> This product is superseded by [Org Level Webhooks](doc:organization-level-webhook), which we recommend for improved functionality and integration.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "account",
                "settings",
                "webhook_details"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
