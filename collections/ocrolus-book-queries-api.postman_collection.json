          "name": "Book from loan",
          "request": {
            "name": "Book from loan",
            "description": {
              "content": "This API endpoint lets you retrieve the Ocrolus <<glossary:Book>> associated with a specific Encompass loan. You can query it using either the `Encompass loan_id` (GUID) or the `loan_number`, depending on which identifier you have available. \n\n> 📘 Note:\n> The system accepts either `loan_id` or `loan_number` to identify the loan. If both parameters are provided, or if neither is included in the request payload, the API returns a 400 error.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "los-connect",
                "encompass",
                "book"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "loan_id",
                  "value": "<string>",
                  "description": "The unique Encompass loan identifier expressed in Globally Unique Identifier (GUID) format."
                },
                {
                  "disabled": false,
                  "key": "loan_number",
                  "value": "<string>",
                  "description": "The numeric identifier assigned to an Encompass loan."
