          "name": "Configure webhook secret",
          "request": {
            "name": "Configure webhook secret",
            "description": {
              "content": "This API configures the secret key for a specific org-level webhook. Use this endpoint to add a new secret or update an existing one. The secret is used to sign webhook payloads using HMAC SHA256, allowing you to verify that requests originate from Ocrolus.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "webhook",
                ":webhook_uuid",
                "rotate-secret"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "webhook_uuid",
                  "description": "(Required) The unique identifier of the webhook."
